# Wise-Edge-LR — env 템플릿 (커밋용, placeholder만). 실제 값은 .env.<env> 에.
ENV=local
# DB: local=sqlite(file), dev+=postgres
DATABASE_URL=file:./local.db
# DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_BASE=http://localhost:3001

# --- 온프레미스 LLM 런타임 (PRD §7) ---
LLM_BACKEND=ollama                 # ollama | mlx | llamacpp | vllm
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=                   # 한글 임베딩 모델 (선정 후 기입)
PGVECTOR_ENABLED=true

# --- 인증/세션 (JWT HS256) ---
JWT_SECRET=                            # prod 주입 필수 (로컬 HS256 세션)
AUTH_DEV_LOGIN=false                   # local 만 true (dev 토큰 발급)
# 외부 IdP/SSO (OIDC) — 설정 시 RS256/JWKS 검증 활성
OIDC_ISSUER=                           # 예: https://keycloak.example/realms/app
OIDC_ROLES_CLAIM=realm_access.roles    # 역할 클레임 경로(점표기)
OIDC_CLEARANCE_CLAIM=clearance         # 등급 클레임(O/S/C)
# OIDC_JWKS=                           # (선택) JWKS JSON 직접 주입(미설정 시 디스커버리)

# 시크릿(DB 비번/토큰/서명)은 절대 커밋 금지 — Vault/Secret Manager 주입
